{
  "name": "dbi-backend",
  "version": "0.4.2",
  "description": "Database importer backend",
  "type": "module",
  "main": "app.ts",
  "scripts": {
    "test:build": "node -e \"require('fs').rmSync('dist-test', { recursive: true, force: true })\" && tsc -p tsconfig.node-test.json",
    "test:run": "node dist-test/test/node-runner.js",
    "test": "npm run test:build && npm run test:run",
    "dev": "node --watch --import tsx -r dotenv/config ./src/index.ts",
    "dev:local": "cross-env AUTH_MODE=none node --watch --import tsx -r dotenv/config ./src/index.ts",
    "comp": "tsc --declaration",
    "preprod": "tsc && node -r dotenv/config ./dist/index.js",
    "start": "node dist/index.js",
    "startdev": "tsc && node -r dotenv/config dist/index.js"
  },
  "keywords": [
    "MSSQL",
    "Import",
    "Database",
    "CSV",
    "Excel",
    "Copy&Paste"
  ],
  "author": "Michael Ronge",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-ntlm": "^2.3.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "@types/tsqlstring": "^1.0.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-ntlm": "^2.6.2",
    "express-validator": "^7.0.1",
    "mssql": "^12.0.0",
    "supertest": "^7.2.2",
    "tsqlstring": "^1.0.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
